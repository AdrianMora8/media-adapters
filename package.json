{
  "name": "seanime-es-providers",
  "version": "0.1.0",
  "private": true,
  "description": "Providers de streaming en español para Seanime",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:av1": "esbuild src/animeav1/index.ts --bundle --format=esm --target=es2017 --platform=neutral --minify-whitespace --minify-syntax --tree-shaking=false --outfile=dist/animeav1/index.js",
    "build:jkanime": "esbuild src/jkanime/index.ts --bundle --format=esm --target=es2017 --platform=neutral --minify-whitespace --minify-syntax --tree-shaking=false --outfile=dist/jkanime/index.js",
    "build": "npm run typecheck && npm run build:av1 && npm run build:jkanime",
    "watch:av1": "npm run build:av1 -- --watch",
    "smoke:av1": "npm run build:av1 && node _smoke.mjs",
    "smoke:jkanime": "npm run build:jkanime && node _smoke-jkanime.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
